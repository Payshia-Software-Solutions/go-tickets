# PayHere Payment Gateway Configurations
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_MODE=sandbox
PAYHERE_DOMAIN_NAME=https://gotickets.silverray.lk
PAYHERE_SERVER_URL=https://gotickets-server.payshia.com

# Database Connection
DB_HOST=localhost
DB_NAME=payshiac_gotickets
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# FTP Configuration (Certificates & Remote Assets)
FTP_SERVER=ftp.gotickets.lk
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_PORT=21

# Email & Notification Settings (SMTP)
SMTP_HOST=mail.gotickets.lk
SMTP_PORT=465
SMTP_USERNAME=no-reply@gotickets.lk
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=no-reply@gotickets.lk
SMTP_FROM_NAME="GoTickets.lk | Discover Your Next Event"

# Comma-separated list of CC email addresses to notify on each booking.
# Tip: Leave empty (SMTP_CC_EMAILS=) during testing to avoid emailing staff members!
SMTP_CC_EMAILS=reservation@silverray.lk,chalanik@silverray.lk,sanjayad@silverray.lk,shanilka@silverray.lk
